# Copy this file to .env locally, or set these in your hosting provider.
PORT=3000
PREFIX=.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/asta_mini

# Optional external API credentials (never commit real keys)
LAKVISION_API_KEY=replace_with_lakvision_key
MOVIEMANIA_API_KEY=replace_with_moviemania_key
TIKTOK_API_KEY=replace_with_tiktok_key
WPREACT_API_KEY=replace_with_wpreact_key
